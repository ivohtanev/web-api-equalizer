{
  "manifest_version": 3,
  "name": "Web API Equalizer",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "A ten-band Web Audio equalizer for the audio of any supported browser tab.",
  "permissions": ["storage", "tabCapture", "offscreen", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Web API Equalizer",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
